    },
    {
      "code": "E_INTERNAL",
      "when": "Lỗi không lường trước",
      "source": "specs/001-repo-scaffold/data-model.md"
    },
    {
      "code": "E_DIAG_FAIL",
      "when": "Lỗi nghiệp vụ mẫu của sf diag fail",
      "source": "specs/001-repo-scaffold/data-model.md"
    },
    {
      "code": "E_LLM_FIXTURE_MISSING",
