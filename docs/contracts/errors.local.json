    },
    {
      "code": "E_TEST_NO_REPO",
      "when": "sf test chạy ngoài repo nguồn",
      "source": "specs/001-repo-scaffold/contracts/cli.md"
    },
    {
      "code": "E_CHANNEL_EXISTS",
      "when": "Khởi tạo kênh trong thư mục đã có channel.json",
