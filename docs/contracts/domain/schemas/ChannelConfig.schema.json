{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ChannelConfig",
  "definitions": {
    "ChannelConfig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number"
        },
        "id": {
          "$ref": "#/definitions/ChannelId"
        },
        "name": {
          "type": "string"
        },
        "language": {
          "$ref": "#/definitions/Lang"
        },
        "created_at": {
          "$ref": "#/definitions/Iso8601"
        },
        "profile_dir": {
          "type": "string",
          "const": "profile"
        },
        "config": {
          "type": "object",
          "properties": {
            "output.profile": {},
            "workflow.default": {},
            "voice.id": {},
            "voice.pause_after_ms": {},
            "look.id": {},
            "font.family": {},
            "caption.style": {},
            "caption.max_words": {},
            "overlay.rules": {},
            "text.producer": {},
            "text.critic": {},
            "text.aux": {},
            "agent.fallback.enabled": {},
            "agent.fallback.model": {},
            "agent.fallback.command": {},
            "refine.min_rounds": {},
            "refine.max_rounds": {},
            "refine.threshold": {},
            "advanced.refine": {},
            "advanced.music": {},
            "advanced.reasoning": {},
            "advanced.custom_frames": {},
            "frame.min_duration_ms": {},
            "frame_build.parallel": {},
            "frame_build.model": {},
            "frame_build.model_simple": {},
            "budget.tokens_per_video": {},
            "budget.api_cost_usd_per_video": {},
            "budget.cache_gb": {},
            "music.volume_db": {},
            "music.duck_db": {},
            "asr.max_regen": {},
            "lipsync.enabled": {},
            "workflow.autopilot": {},
            "workflow.key_approvals": {},
            "policy.auto_approve.batch_gen": {},
            "policy.auto_approve.paid_api": {},
            "check.duration_tolerance": {},
            "meta.title_max": {},
            "meta.description_max": {},
            "meta.hashtags": {},
            "policy.batch.tts_lines": {},
            "policy.batch.images": {},
            "policy.paid_api.per_call_usd": {},
            "policy.budget_warn_ratio": {},
            "gpu.vram_total_gb": {},
            "autopilot.enabled": {},
            "autopilot.paused": {},
            "autopilot.background": {},
            "trash.retention_days": {},
            "autopilot.asr_accept_ratio": {},
            "autopilot.competitors": {},
            "autopilot.pillars": {},
            "autopilot.workflows": {},
            "autopilot.max_per_day": {},
            "autopilot.min_score": {},
            "autopilot.duration_waive_ratio": {},
            "autopilot.work_window": {},
            "autopilot.budget_share": {},
            "autopilot.daily_tokens": {},
            "autopilot.learning": {},
            "report.enabled": {},
            "report.time": {},
            "telegram.enabled": {},
            "telegram.chat_id": {},
            "telegram.allowed_user_ids": {},
            "publish.youtube.audited": {},
            "publish.ai_disclosure": {},
            "publish.tiktok.audited": {},
            "publish.facebook.page_id": {},
            "publish.youtube.channel_id": {},
            "publish.platforms": {},
            "publish.slots": {},
            "publish.timezone": {},
            "publish.veto_hours": {}
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "config",
        "created_at",
        "id",
        "language",
        "name",
        "profile_dir",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "ChannelId": {
      "$ref": "#/definitions/Id%3C%22ch%22%3E"
    },
    "Id<\"ch\">": {
      "type": "string",
      "pattern": "^ch_[0-9a-z]{8}$"
    },
    "Lang": {
      "type": "string",
      "enum": [
        "vi",
        "de",
        "en"
      ]
    },
    "Iso8601": {
      "type": "string"
    }
  }
}
