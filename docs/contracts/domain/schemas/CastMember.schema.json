{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CastMember",
  "definitions": {
    "CastMember": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/CastId"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "narrator",
            "character"
          ]
        },
        "voice_id": {
          "$ref": "#/definitions/VoiceId"
        },
        "emotions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RelPath"
          }
        },
        "reference_images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssetId"
          }
        },
        "expressions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AssetId"
          }
        },
        "mouth_set": {
          "type": "string"
        },
        "mouth_anchor": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "scale"
          ],
          "additionalProperties": false
        },
        "caption_color": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "voice_id",
        "reference_images"
      ],
      "additionalProperties": false
    },
    "CastId": {
      "$ref": "#/definitions/Id%3C%22ca%22%3E"
    },
    "Id<\"ca\">": {
      "type": "string",
      "pattern": "^ca_[0-9a-z]{8}$"
    },
    "VoiceId": {
      "$ref": "#/definitions/Id%3C%22vo%22%3E"
    },
    "Id<\"vo\">": {
      "type": "string",
      "pattern": "^vo_[0-9a-z]{8}$"
    },
    "RelPath": {
      "type": "string"
    },
    "AssetId": {
      "$ref": "#/definitions/Id%3C%22as%22%3E"
    },
    "Id<\"as\">": {
      "type": "string",
      "pattern": "^as_[0-9a-z]{8}$"
    }
  }
}
