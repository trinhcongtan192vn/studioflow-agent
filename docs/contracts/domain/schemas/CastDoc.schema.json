{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CastDoc",
  "definitions": {
    "CastDoc": {
      "type": "object",
      "properties": {
        "front": {
          "$ref": "#/definitions/CastFrontMatter"
        },
        "cast": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CastEntry"
          }
        }
      },
      "required": [
        "front",
        "cast"
      ],
      "additionalProperties": false
    },
    "CastFrontMatter": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number"
        },
        "video_id": {
          "$ref": "#/definitions/VideoId"
        }
      },
      "required": [
        "schema_version",
        "video_id"
      ],
      "additionalProperties": false,
      "description": "D3 5.6 — front matter của CAST.md (video)."
    },
    "VideoId": {
      "$ref": "#/definitions/Id%3C%22vd%22%3E"
    },
    "Id<\"vd\">": {
      "type": "string",
      "pattern": "^vd_[0-9a-z]{8}$"
    },
    "CastEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "narrator",
            "character"
          ]
        },
        "voice_id": {
          "$ref": "#/definitions/VoiceId"
        },
        "emotions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/RelPath"
          }
        },
        "reference_images": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AssetId"
          }
        },
        "expressions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AssetId"
          }
        },
        "mouth_set": {
          "type": "string"
        },
        "mouth_anchor": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "scale"
          ],
          "additionalProperties": false
        },
        "caption_color": {
          "type": "string"
        },
        "look": {
          "type": "string",
          "description": "Ngoại hình bằng chữ (tiếng Anh, cố định) — bước Ảnh sinh ảnh chuẩn + mọi tư thế từ đây khi chưa có reference_images (2026-10-10)."
        },
        "id": {
          "$ref": "#/definitions/CastId"
        }
      },
      "required": [
        "id"
      ],
      "description": "D3 5.6 — mục trong khối `sf-cast`: tham chiếu cast kênh theo `id`, có thể ghi đè trường."
    },
    "VoiceId": {
      "$ref": "#/definitions/Id%3C%22vo%22%3E"
    },
    "Id<\"vo\">": {
      "type": "string",
      "pattern": "^vo_[0-9a-z]{8}$"
    },
    "RelPath": {
      "type": "string"
    },
    "AssetId": {
      "$ref": "#/definitions/Id%3C%22as%22%3E"
    },
    "Id<\"as\">": {
      "type": "string",
      "pattern": "^as_[0-9a-z]{8}$"
    },
    "CastId": {
      "$ref": "#/definitions/Id%3C%22ca%22%3E"
    },
    "Id<\"ca\">": {
      "type": "string",
      "pattern": "^ca_[0-9a-z]{8}$"
    }
  }
}
